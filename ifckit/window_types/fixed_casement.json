{
  "version": 1,
  "parameters": {
    "w": 1000,
    "h": 1000,
    "lining_depth": 70,
    "lining_thickness": 55,
    "panel_depth": 6,
    "glazing_inset": 20
  },
  "opening_nodes": [
    {
      "id": "opening_rect",
      "op": "rect",
      "p0": [0, 0],
      "p1": ["$w", "$h"]
    },
    {
      "id": "opening_void",
      "op": "extrude",
      "profile": "opening_rect",
      "depth": "2 * $wall_thickness",
      "z_offset": 0,
      "output": true,
      "role": "Opening",
      "material": {
        "color": {"r": 0.5, "g": 0.5, "b": 0.5},
        "transparency": 1.0,
        "name": "Opening void"
      }
    }
  ],
  "nodes": [
    {
      "id": "lining_profile",
      "op": "rect",
      "p0": [0, 0],
      "p1": ["$w", "$h"],
      "holes": [
        {
          "op": "offset",
          "dist": "$lining_thickness"
        }
      ]
    },
    {
      "id": "lining",
      "op": "extrude",
      "profile": "lining_profile",
      "depth": "$lining_depth",
      "z_offset": 0,
      "output": true,
      "role": "Lining",
      "material": {
        "color": {"r": 0.8, "g": 0.8, "b": 0.8},
        "transparency": 0.95,
        "name": "Aluminum frame"
      }
    },
    {
      "id": "glazing_rect",
      "op": "rect",
      "p0": ["$lining_thickness", "$lining_thickness"],
      "p1": ["$w - $lining_thickness", "$h - $lining_thickness"]
    },
    {
      "id": "glazing",
      "op": "extrude",
      "profile": "glazing_rect",
      "depth": "$panel_depth",
      "z_offset": "$lining_depth / 2 - $panel_depth / 2",
      "output": true,
      "role": "Glazing",
      "material": {
        "color": {"r": 0.9, "g": 0.95, "b": 1.0},
        "transparency": 0.1,
        "name": "Clear glass"
      }
    }
  ]
}
